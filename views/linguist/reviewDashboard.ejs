<!DOCTYPE html>
<html>
<head>
  <title><%= pageTitle %></title>
  <link rel="stylesheet" href="/css/linguistDashboard.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/typography"></script>
  <script>
  tailwind.config = {
    theme: {
      extend: {},
    },
    plugins: [tailwindcss.typography],
  };
  </script>

</head>

<body>

<div class="container">

  <!-- TOP BAR -->
  <div class="top-bar">
    <a href="#" class="logout" id="linguistLogoutBtn">Logout</a>
  </div>

  <div class="flex justify-center gap-4 mb-6">
  <button id="tabCourses" class="tab-btn active">📋 Course Review</button>
  <button id="tabDictionary" class="tab-btn">📚 Dictionary</button>
</div>

<div id="coursesTab">
<h1 class="page-title">Linguist Review Dashboard</h1>

  <% if (courses.length === 0) { %>
    <div class="empty">No pending courses 🎉</div>
  <% } %>

  <% courses.forEach(course => { %>
    <div class="card">

      <!-- COURSE HEADER -->
      <div class="card-header">
        <a href="/linguist/preview/course/<%= course._id %>" class="title-link">
          <%= course.title %>
          <span class="view-hint">View</span>
        </a>
        <span class="badge">PENDING</span>
      </div>

<% if (course.changeSummary) { %>
  <div class="card" style="background:#fff7ed; border-color:#facc15;">
    <strong>📝 Changes since last review</strong>
    <p style="margin-top:8px;"><%= course.changeSummary %></p>
  </div>
<% } %>


<div class="prose max-w-none
            prose-p:text-[--brown-dark]
            prose-em:text-[--brown]
            prose-strong:text-[--brown-dark]">
  <%- course.description %>
</div>


      <!-- LESSONS -->
      <div class="section">
        <h3>📚 Lessons</h3>

        <% lessons
          .filter(l => String(l.courseId) === String(course._id))
          .forEach(lesson => { %>

          <div class="lesson">
            <a href="/linguist/preview/lesson/<%= lesson._id %>" class="title-link">
              <%= lesson.title %>
              <span class="view-hint">View</span>
            </a>
          </div>

        <% }) %>
      </div>

      <!-- QUIZZES -->
      <div class="section">
        <h3>🧩 Quizzes & Final Exam</h3>

        <% quizzes
          .filter(q =>
  String(q.courseId) === String(course._id) ||
  lessons.some(l =>
    String(l._id) === String(q.lessonId) &&
    String(l.courseId) === String(course._id)
  )
)

          .forEach(quiz => { %>

          <div class="quiz">
            <a href="/linguist/preview/quiz/<%= quiz._id %>" class="title-link">
              <%= quiz.title %>
              <span class="view-hint">View</span>
            </a>
          </div>

        <% }) %>
      </div>

      <!-- ACTIONS -->
      <div class="section">
        <div class="actions">
          <form method="POST" action="/linguist/review/course/<%= course._id %>/approve" style="margin-bottom: 16px;">
            <button class="approve">Approve Course</button>
          </form>
        </div>

        <form method="POST" action="/linguist/review/course/<%= course._id %>/reject">
          <textarea name="notes" placeholder="Rejection reason (required)" required></textarea>
          <div class="actions">
            <button class="reject">Reject Course</button>
          </div>
        </form>
      </div>

    </div>
  <% }) %>
</div>

<div id="dictionaryTab" style="display:none;">

  <h2 class="text-xl font-bold mb-4 text-center">Translator Database</h2>

  <!-- ADD WORD -->
  <div class="card">
    <h3 class="font-semibold mb-2">➕ Add Translation</h3>

    <form id="addWordForm" class="flex gap-2 flex-wrap">
      <input name="tagalog" placeholder="Tagalog" required class="border p-2 rounded"/>
      <input name="chavacano" placeholder="Chabacano" required class="border p-2 rounded"/>
      <input name="category" placeholder="Category" required class="border p-2 rounded"/>
      <button class="approve">Add</button>
    </form>
  </div>

  <div class="card mb-4">
    <input
      type="text"
      id="wordFilter"
      placeholder="Search Tagalog or Chavacano"
      class="border p-2 rounded w-full"
    />
  </div>

  <!-- WORD LIST -->
  <div class="card mt-4">
    <h3 class="font-semibold mb-2">📋 All Words</h3>
    <div id="wordList" class="space-y-2 max-h-[400px] overflow-y-auto"></div>
  </div>

</div>

</div>
  <script src="/js/linguist.js"></script>

</body>
</html>
